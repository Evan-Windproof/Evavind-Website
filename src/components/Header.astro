---
import GitHubIcon from './GitHubIcon.astro';
import { repositories } from '../project';
---
<header class="site-header">
  <a class="brand" href="/" aria-label="Evavind home">
    <img src="/favicon.svg" width="42" height="42" alt="" />
    <span>Evavind</span>
  </a>
  <nav class="desktop-nav" aria-label="Main navigation">
    <a href="#explore">Explore</a>
    <a href="#architecture">Architecture</a>
    <a href={repositories.os} aria-label="Evavind OS on GitHub"><GitHubIcon /></a>
  </nav>
  <details class="mobile-nav">
    <summary>Menu</summary>
    <nav aria-label="Mobile navigation">
      <a href="#explore">Explore</a>
      <a href="#architecture">Architecture</a>
      <a href={repositories.os}><GitHubIcon /> GitHub</a>
    </nav>
  </details>
</header>

<script>
  const menu = document.querySelector<HTMLDetailsElement>('.mobile-nav');
  menu?.addEventListener('click', (event) => {
    if (event.target instanceof Element && event.target.closest('a')) menu.open = false;
  });
  menu?.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && menu.open) {
      menu.open = false;
      menu.querySelector('summary')?.focus();
    }
  });
</script>
